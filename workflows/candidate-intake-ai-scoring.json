    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"score\": 82,\n  \"reasons\": [\"4 years in fintech product management\", \"payments and SQL experience\", \"English C1 meets B2\"],\n  \"missing\": [\"Jira not confirmed in practice\"]\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1384,
        456
      ],
      "name": "Output Schema (Scoring)",
      "id": "bb20aef2-e824-4763-af7d-ced4e74d2e33"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO applications (candidate_id, vacancy_id, ai_score, ai_reasons, status)\nVALUES ($1, $2, $3, $4, 'new')\nON CONFLICT (candidate_id, vacancy_id) DO UPDATE SET\n  ai_score = EXCLUDED.ai_score,\n  ai_reasons = EXCLUDED.ai_reasons\nRETURNING id, candidate_id, vacancy_id, ai_score;",
        "options": {
          "queryReplacement": "={{ [ $('Upsert Candidate').item.json.id, $('Get Vacancy').item.json.id,$json.output.score, $json.output.reasons.join('; ') + ($json.output.missing.length ? ' | Missing: ' + $json.output.missing.join('; ') : '') ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1600,
        224
      ],
      "name": "Save Application",
      "credentials": {
