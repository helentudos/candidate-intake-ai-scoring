      "name": "Notify Recruiter",
      "credentials": {
        "telegramApi": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "Telegram account"
        }
      },
      "id": "70b034af-b1f2-4b18-9074-756e4d9669d0"
    },
    {
      "parameters": {
        "jsCode": "const esc = (s) => String(s ?? '—')\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;');\n\nconst cand = $('Normalize Candidate').item.json;\nconst vac = $('Get Vacancy').item.json;\nconst score = $('Score Candidate').item.json.output;\n\nconst bullets = (list) =>\n  list && list.length ? list.map(x => '• ' + esc(x)).join('\\n') : '• nothing';\n\nconst text = [\n  '🟢 <b>New strong candidate</b>',\n  '',\n  `${esc(cand.full_name)} → ${esc(vac.title)}`,\n  `Score: <b>${score.score}/100</b>`,\n  `Salary: ${esc(cand.salary_expectation_eur)} EUR (budget ${esc(vac.salary_max_eur)} EUR)`,\n  '',\n  'Why:',\n  bullets(score.reasons),\n  '',\n  'Missing:',\n  bullets(score.missing),\n  '',\n  `Email: ${esc(cand.email)}`\n].join('\\n');\n\nreturn { text };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2048,
        224
      ],
      "name": "Build Recruiter Message",
      "id": "72afec7e-4773-4377-8aec-7a7250df37f1"
    }
