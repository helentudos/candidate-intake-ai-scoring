    {
      "parameters": {
        "promptType": "define",
        "text": "=Extract candidate data from the CV text. Use ONLY facts written in the text. If something is missing, use null. Do not guess.\n\nFull name: {{ $json[\"Full name\"] }}\nEmail: {{ $json[\"Email\"] }}\nCV text:\n{{ $json[\"CV text\"] }}\nInclude the person's role or profession (e.g. \"product management\", \"customer support\") in skills.",
        "hasOutputParser": true,
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        224,
        224
      ],
      "name": "Extract Candidate Data",
      "id": "8f1213dd-d955-4458-ac33-372444026266"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4.1-mini",
          "mode": "list",
          "cachedResultName": "gpt-4.1-mini"
