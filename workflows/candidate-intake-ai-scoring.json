      ],
      "name": "OpenAI Model (Extraction)",
      "credentials": {
        "openAiApi": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "OpenAI | Portfolio"
        }
      },
      "id": "2334165b-095e-4eb5-acc7-651316dee3eb"
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"full_name\": { \"type\": [\"string\", \"null\"] },\n    \"email\": { \"type\": [\"string\", \"null\"] },\n    \"skills\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } },\n    \"years_experience\": { \"type\": [\"number\", \"null\"] },\n    \"languages\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } },\n    \"salary_expectation_eur\": { \"type\": [\"number\", \"null\"] }\n  },\n  \"required\": [\"full_name\", \"email\", \"skills\", \"years_experience\", \"languages\", \"salary_expectation_eur\"]\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        360,
        456
      ],
      "name": "Output Schema (Extraction)",
      "id": "84d67607-6335-42c2-8492-8aef75fee28e"
    },
    {
      "parameters": {
        "jsCode": "const c = $json.output;\nconst form = $('Candidate Form').item.json;\n\nreturn {\n  full_name: (c.full_name || form['Full name']).trim(),\n  email: (c.email || form['Email']).trim().toLowerCase(),\n  skills: (c.skills || []).join(', '),\n  years_experience: c.years_experience ?? null,\n  languages: (c.languages || []).join(', '),\n  salary_expectation_eur: c.salary_expectation_eur ?? null,\n  source: 'web form',\n  vacancy_title: form['Vacancy'],\n  cv_text: form['CV text']\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        576,
        224
      ],
      "name": "Normalize Candidate",
      "id": "a5531239-93c3-4f42-9f06-9192a7a625d6"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO candidates\n  (full_name, email, skills, years_experience, languages, salary_expectation_eur, source)\nVALUES ($1, $2, $3, $4, $5, $6, $7)\nON CONFLICT (email) DO UPDATE SET\n  full_name = EXCLUDED.full_name,\n  skills = EXCLUDED.skills,\n  years_experience = EXCLUDED.years_experience,\n  languages = EXCLUDED.languages,\n  salary_expectation_eur = EXCLUDED.salary_expectation_eur\nRETURNING id, email;",
        "options": {
          "queryReplacement": "={{ [ $json.full_name, $json.email, $json.skills, $json.years_experience, $json.languages, $json.salary_expectation_eur, $json.source ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        800,
        224
      ],
      "name": "Upsert Candidate",
      "credentials": {
        "postgres": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "Neon – evotym-demo"
        }
      },
      "id": "6efac87f-ce4e-41ee-baca-b7560581080c"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, title, required_skills, nice_to_have, min_years, languages, salary_max_eur\nFROM vacancies\nWHERE title = $1 AND status = 'open'\nLIMIT 1;",
        "options": {
          "queryReplacement": "={{ [ $('Normalize Candidate').item.json.vacancy_title ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1024,
        224
      ],
      "name": "Get Vacancy",
      "credentials": {
        "postgres": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "Neon – evotym-demo"
        }
      },
      "id": "aeebae24-db5e-44bf-9dae-847e3c28463d"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a recruiter's assistant. Score how well the candidate fits the vacancy from 0 to 100.\nUse ONLY the facts below. Do not invent experience or skills.\nTreat sub-areas and synonyms as a match (e.g. \"card payment flows\" counts as \"payments\", \"PM\" counts as \"product management\").\n\nScoring rubric (add up the points):\n- Required skills: up to 40 (proportional to how many are matched)\n- Experience vs minimum ({{ $json.min_years }} years): below minimum = 0-5, equal to minimum = 10, minimum + 2 years or more = 20\n- Nice-to-have skills: up to 20 (proportional to how many are matched)\n- Languages: meets the requirement = 15, clearly exceeds it = 20, below = 0-5\nSalary is NOT part of the score (it is checked separately).\n\nCalibration: a typical good candidate scores 70-85. Give 90+ only if ALL required skills match, experience is well above the minimum AND most nice-to-have skills match. Do not round up.\n\nVACANCY\nTitle: {{ $json.title }}\nRequired skills: {{ $json.required_skills }}\nNice-to-have skills: {{ $json.nice_to_have }}\nMinimum experience: {{ $json.min_years }} years\nLanguages: {{ $json.languages }}\n\nCANDIDATE\nName: {{ $('Normalize Candidate').item.json.full_name }}\nSkills: {{ $('Normalize Candidate').item.json.skills }}\nYears of experience: {{ $('Normalize Candidate').item.json.years_experience }}\nLanguages: {{ $('Normalize Candidate').item.json.languages }}\nCV text: {{ $('Normalize Candidate').item.json.cv_text }}\n\nReturn the score, 2-3 short reasons and the missing requirements (including missing nice-to-have skills).",
        "hasOutputParser": true,
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        1248,
        224
      ],
      "name": "Score Candidate",
      "id": "bdf9d91b-12d0-4142-b686-1148806cb1a2"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4.1-mini",
          "mode": "list",
          "cachedResultName": "gpt-4.1-mini"
        },
        "builtInTools": {},
        "options": {
          "temperature": 0
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
