          "id": "YOUR_CREDENTIAL_ID",
          "name": "Neon – evotym-demo"
        }
      },
      "id": "352d54a6-23a2-42d6-8a1c-ce07ac0879d8"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 4
          },
          "conditions": [
            {
              "leftValue": "={{ $('Score Candidate').item.json.output.score }}",
              "rightValue": 70,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
